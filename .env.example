# Root environment template for FANOS AI — Unified AI-Powered Cybersecurity Platform
# Copy to .env for local development and keep secrets local.

APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string
DATABASE_URL=postgresql+asyncpg://fanos:fanos_pass@localhost:5432/fanos_db
DATABASE_SYNC_URL=postgresql://fanos:fanos_pass@localhost:5432/fanos_db
REDIS_URL=redis://localhost:6379/0
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Threat Intelligence (VirusTotal Integration)
VT_API_KEY=your_virustotal_api_key_here

# Telegram Security Bot (Optional Integration)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Sensor & Infrastructure Control
FANOS_SENSOR_TOKEN=dev_sensor_secret_token_123
