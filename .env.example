# Root environment template for FANOS AI
# Copy to .env for local development and keep secrets local.

APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+asyncpg://fanos:fanos_pass@localhost:5432/fanos_db
DATABASE_SYNC_URL=postgresql://fanos:fanos_pass@localhost:5432/fanos_db
REDIS_URL=redis://localhost:6379/0
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
